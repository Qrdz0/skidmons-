<body>
<div class="container">
    <header>
        <h1>🪁 Skidmons <small>– Roblox Limiteds</small></h1>
        <div class="controls">
            <input type="text" id="search" placeholder="Search items..." oninput="filterTable()">
            <button class="btn btn-primary" onclick="fetchData()">🔄 Refresh</button>
        </div>
    </header>

    <div class="stats" id="stats">
        <div>Items: <span id="itemCount">0</span></div>
        <div>Last updated: <span id="lastUpdated">—</span></div>
    </div>

    <div id="tableContainer">
        <div class="loading">Loading limited items from Rolimon's API...</div>
    </div>

    <div class="footer">
        Data sourced from <a href="https://www.rolimons.com" target="_blank" style="color:#f0883e;">Rolimon's</a> · Not affiliated with Roblox
    </div>
</div>

<script>
    let items = [];
    let originalItems = [];

    async function fetchData() {
        const container = document.getElementById('tableContainer');
        container.innerHTML = '<div class="loading">⏳ Fetching data...</div>';
        document.getElementById('itemCount').textContent = '...';

        try {
            const response = await fetch('https://www.rolimons.com/api/items');
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const data = await response.json();
            // data is an object with item IDs as keys
            originalItems = Object.entries(data).map(([id, info]) => ({
                id: parseInt(id),
                name: info.name || 'Unknown',
                value: info.value || 0,
                demand: info.demand || 0,
                trend: info.trend || 'stable', // "rising", "falling", "stable"
                projected: info.projected || false,
            }));
            items = [...originalItems];
            renderTable(items);
            document.getElementById('itemCount').textContent = items.length;
            document.getElementById('lastUpdated').textContent = new Date().toLocaleTimeString();
        } catch (err) {
            container.innerHTML = `<div class="loading" style="color:#f85149;">❌ Error: ${err.message}</div>`;
        }
    }

    function renderTable(itemsToShow) {
        const container = document.getElementById('tableContainer');
        if (!itemsToShow || itemsToShow.length === 0) {
            container.innerHTML = '<div class="loading">No items found.</div>';
            return;
        }

        let html = `
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Value (R$)</th>
                        <th>Demand</th>
                        <th>Trend</th>
                    </tr>
                </thead>
                <tbody>
        `;
        itemsToShow.forEach(item => {
            const trendClass = item.trend === 'rising' ? 'trend-up' :
                              item.trend === 'falling' ? 'trend-down' : 'trend-steady';
            const trendSymbol = item.trend === 'rising' ? '⬆' :
                                item.trend === 'falling' ? '⬇' : '➖';
            const demandText = item.demand > 0 ? `${item.demand}%` : '—';
            html += `
                <tr>
                    <td class="item-name">${item.name}</td>
                    <td class="item-value">${item.value.toLocaleString()}</td>
                    <td>${demandText}</td>
                    <td class="${trendClass}">${trendSymbol} ${item.trend}</td>
                </tr>
            `;
        });
        html += `</tbody></table>`;
        container.innerHTML = html;
    }

    function filterTable() {
        const query = document.getElementById('search').value.toLowerCase().trim();
        if (!query) {
            items = [...originalItems];
        } else {
            items = originalItems.filter(item => 
                item.name.toLowerCase().includes(query)
            );
        }
        renderTable(items);
        document.getElementById('itemCount').textContent = items.length;
    }

    // Initial load
    fetchData();

    // Auto-refresh every 2 minutes
    setInterval(fetchData, 120000);
</script>
</body>
</html>
